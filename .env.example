DATABASE_URL=postgresql://quallection:quallection@localhost:5432/quallection
POSTGRES_USER=quallection
POSTGRES_PASSWORD=quallection
POSTGRES_DB=quallection

# NextAuth — required
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Deploy environment + verifier door (VLT-36). FAIL-CLOSED: unset means production.
# NODE_ENV is "production" in every image, so it cannot tell staging apart.
# Staging sets DEPLOY_ENV=staging and VERIFIER_SECRET; production sets NEITHER —
# POST /api/verifier/session refuses in production whatever secret is presented.
DEPLOY_ENV=local
VERIFIER_SECRET=

# Anthropic — required for valuations and pursuit search
ANTHROPIC_API_KEY=

# Cron container shared secret — must match between the app and cron containers.
# Generate with `openssl rand -hex 32`. Without it, /api/pursuits/run-search can
# only be invoked by a signed-in browser session.
CRON_SECRET=

# Management API — bearer token for the cross-app dashboard's /api/mgmt/v1/*
# endpoints. Generate with `openssl rand -base64 32`. Leave blank to disable
# the mgmt API entirely (every endpoint returns 503).
MGMT_API_TOKEN=

# Set to 1 to reject mgmt API calls that came through the public Railway edge
# (any request with an X-Forwarded-For header). Pairs with private-network
# calls via <service>.railway.internal. Recommended in production once the
# dashboard is set up to call internally.
MGMT_REQUIRE_INTERNAL=0

# Cloudflare R2 — object storage for uploaded images. When all four vars are
# set, the app writes new uploads to R2 and serves them via short-lived
# presigned URLs. When unset, /api/upload writes to public/uploads/ on local
# disk (useful for `npm run dev` without provisioning a bucket).
#
# To set up in Cloudflare: R2 → Create bucket → API tokens → "Object Read & Write".
# Bucket should be private (the app generates presigned URLs per view).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Marketplace listing integration (CUR-1) — encrypts per-user Reverb/eBay tokens
# at rest (lib/listings/crypto.ts). Optional: a 32-byte key as base64 or hex. If
# unset, a key is derived from NEXTAUTH_SECRET, so existing deploys work as-is.
# Class: Runtime secret.
MARKETPLACE_ENC_KEY=

# eBay Marketplace Account Deletion notification endpoint
# (/api/marketplace/ebay/account-deletion). Required before an eBay PRODUCTION
# keyset activates. TOKEN: 32–80 chars [A-Za-z0-9_-], must match the token
# entered in the eBay developer portal. ENDPOINT_URL: the exact HTTPS URL
# registered there (eBay hashes with that exact string); falls back to
# NEXTAUTH_URL + the route path when unset. Class: Runtime secret / config.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# eBay OAuth ("Connect eBay" flow, /api/marketplace/ebay/connect|callback).
# CLIENT_ID = App ID/Client ID from the keyset; CLIENT_SECRET = the keyset's
# "Cert ID"; RUNAME = the eBay Redirect URL name (NOT the raw callback URL) whose
# "Auth accepted URL" points at /api/marketplace/ebay/callback. Set EBAY_SANDBOX
# to true to use eBay's sandbox OAuth + API hosts. All three of ID/SECRET/RUNAME
# must be set for the Connect flow to activate. Class: Runtime secret / config.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_SANDBOX=

# Admin allowlist — comma-separated emails granted admin role by lib/admin.ts.
# Class: Runtime config (non-secret). Used for moderation queue, refresh jobs.
ADMIN_EMAILS=  # comma-separated emails (e.g., nick@nextideaup.com,phil@nextideaup.com)

# Google OAuth (NextAuth) — when both are set, GoogleProvider is registered.
# GOOGLE_CLIENT_ID is a Runtime config (non-secret OAuth identifier);
# GOOGLE_CLIENT_SECRET is a Runtime secret.
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Azure AD OAuth (NextAuth) — all three must be set to register AzureADProvider.
# Client ID + Tenant ID are Runtime config; CLIENT_SECRET is a Runtime secret.
AZURE_AD_CLIENT_ID=<your-azure-ad-client-id>
AZURE_AD_CLIENT_SECRET=<your-azure-ad-client-secret>
AZURE_AD_TENANT_ID=<your-azure-ad-tenant-id>

# Apple OAuth (NextAuth) — all four must be set to register AppleProvider.
# APPLE_ID (Services ID), APPLE_TEAM_ID, APPLE_KEY_ID are Runtime config;
# APPLE_PRIVATE_KEY (.p8 contents, newlines preserved) is a Runtime secret.
APPLE_ID=<your-apple-services-id>
APPLE_TEAM_ID=<your-10-char-apple-team-id>
APPLE_KEY_ID=<your-10-char-apple-key-id>
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<contents>\n-----END PRIVATE KEY-----"

# Vault1 social-token verifier audiences (iOS app sign-in via /api/auth/social).
# Comma-separated allowed audiences for each provider. Falls back to APPLE_ID /
# GOOGLE_CLIENT_ID respectively when unset. Class: Runtime config (non-secret).
VAULT1_APPLE_AUDIENCES=  # comma-separated bundle id(s) + Services ID
VAULT1_GOOGLE_AUDIENCES=  # comma-separated iOS + Web Google client IDs
